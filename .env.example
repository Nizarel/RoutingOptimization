# --- Cosmos DB (required) ---
# Endpoint of the Cosmos DB account; auth uses DefaultAzureCredential (az login locally, MI in cloud).
AZURE_COSMOS_ENDPOINT=https://cosmos-routing-dev.documents.azure.com:443/
AZURE_COSMOS_DATABASE=routing_optimization

# --- Azure Maps (placeholder; not used in skeleton, Haversine stub is used) ---
AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com

# --- MCP server ---
MCP_TRANSPORT=http        # http | stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_LOG_LEVEL=INFO

# --- Routing defaults ---
DEFAULT_ROUTING_PROFILE=truck
MATRIX_CACHE_TTL_SEC=86400

# --- Albertsons constants ---
DEFAULT_DC_CODE=52-DC
